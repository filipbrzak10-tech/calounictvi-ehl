---
import { firma, sluzby, postup, galerie, dotazy } from "../firma.js";
// Texty, kontakty a fotky se upravují v src/firma.js
const roky = new Date().getFullYear() - firma.odRoku;
const mapaOdkaz = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(firma.adresa + ", " + firma.mesto)}`;
const mapa = `https://www.google.com/maps?q=${encodeURIComponent(firma.adresa + ", " + firma.mesto)}&output=embed`;
const hlavni = galerie[0];
---
<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{firma.nazev} | Přečalounění nábytku Hradec Králové</title>
  <meta name="description" content={`Čalounictví v Hradci Králové od roku ${firma.odRoku}. Přečalounění sedaček, křesel, židlí a starožitností. Tel. ${firma.telefon}.`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="nav">
    <a href="#" class="brand">Ehl<span>/</span>čalounictví</a>
    <nav class="links"><a href="#prace">Práce</a><a href="#sluzby">Služby</a><a href="#postup">Postup</a><a href="#dotazy">Dotazy</a></nav>
    <a href="#kontakt" class="pill">Poptávka <span>→</span></a>
  </header>

  <section class="hero">
    <div class="hero-top reveal">
      <p class="tag"><span class="dot"></span>Dílna v Hradci Králové · od roku {firma.odRoku}</p>
    </div>
    <h1 class="reveal">Přečalouníme<br />to, co <em>máte rádi.</em></h1>
    <div class="hero-bottom reveal">
      <p class="lead">Sedačky, křesla, židle i starožitnosti. Nová látka, nová výplň, stejný kus nábytku, ke kterému máte vztah.</p>
      <div class="hero-actions">
        <a class="btn" href={`tel:${firma.telefonOdkaz}`}>Zavolat {firma.telefon}</a>
        <a class="btn ghost" href="#prace">Ukázky práce</a>
      </div>
      <div class="years"><strong>{roky}</strong><span>let<br />řemesla</span></div>
    </div>
    <div class="fabric" aria-hidden="true"></div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="track">
      {[0,1].map(() => (
        <span>Sedačky ✦ Křesla ✦ Jídelní židle ✦ Lavice ✦ Starožitný nábytek ✦ Opravy pružin ✦ Nové výplně ✦ Čalounické potřeby ✦&nbsp;</span>
      ))}
    </div>
  </div>

  <section id="prace" class="sec">
    <div class="head reveal">
      <p class="kicker">01 — Před a po</p>
      <h2>Posuňte a <em>uvidíte rozdíl.</em></h2>
    </div>
    <div class="compare reveal" style="--pos:50%">
      {hlavni.pred ? <img class="layer" src={hlavni.pred} alt={`${hlavni.popis} před`} /> : <div class="layer ph-old"><span>Fotka před</span></div>}
      <div class="layer top">
        {hlavni.po ? <img src={hlavni.po} alt={`${hlavni.popis} po`} /> : <div class="ph-new"><span>Fotka po</span></div>}
      </div>
      <div class="handle"><span>⟷</span></div>
      <input type="range" min="0" max="100" value="50" aria-label="Posunout porovnání před a po" />
      <p class="cap">{hlavni.popis}</p>
    </div>
    <div class="thumbs">
      {galerie.slice(1).map((g, i) => (
        <figure class="thumb reveal">
          {g.po ? <img src={g.po} alt={g.popis} loading="lazy" /> : <div class={`ph-new t${i}`}></div>}
          <figcaption>{g.popis}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section id="sluzby" class="sec">
    <div class="head reveal">
      <p class="kicker">02 — Služby</p>
      <h2>Co se dá <em>zachránit.</em></h2>
    </div>
    <div class="bento">
      {sluzby.map((s, i) => (
        <article class={`tile reveal t${i}`}>
          <span class="n">{String(i + 1).padStart(2, "0")}</span>
          <h3>{s.nazev}</h3>
          <p>{s.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="postup" class="sec">
    <div class="head reveal">
      <p class="kicker">03 — Postup</p>
      <h2>Od fotky k <em>hotovému kusu.</em></h2>
    </div>
    <ol class="timeline">
      {postup.map((k, i) => (
        <li class="reveal"><span class="step">{i + 1}</span><h3>{k.nazev}</h3><p>{k.text}</p></li>
      ))}
    </ol>
  </section>

  <section id="dotazy" class="sec narrow">
    <div class="head reveal">
      <p class="kicker">04 — Časté dotazy</p>
      <h2>Na co se lidé <em>ptají.</em></h2>
    </div>
    <div class="faq">
      {dotazy.map((d) => (
        <details class="reveal"><summary>{d.otazka}<span class="plus"></span></summary><p>{d.odpoved}</p></details>
      ))}
    </div>
  </section>

  <section id="kontakt" class="contact">
    <div class="c-left reveal">
      <p class="kicker light">05 — Kontakt</p>
      <h2>Pošlete fotku,<br /><em>ozvu se s cenou.</em></h2>
      <a class="bigphone" href={`tel:${firma.telefonOdkaz}`}>{firma.telefon}</a>
      <ul class="cinfo">
        <li><span>E-mail</span><a href={`mailto:${firma.email}`}>{firma.email}</a></li>
        <li><span>Dílna</span><a href={mapaOdkaz} target="_blank" rel="noopener">{firma.adresa}, {firma.mesto}</a></li>
        <li><span>Otevřeno</span>{firma.provozni}</li>
      </ul>
      <iframe class="map" src={mapa} loading="lazy" title="Mapa dílny" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
    <form class="form reveal" action={`https://formsubmit.co/${firma.email}`} method="POST">
      <input type="hidden" name="_subject" value="Nová poptávka z webu – čalounictví" />
      <input type="hidden" name="_template" value="table" />
      <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
      <div class="chips" role="radiogroup" aria-label="Co potřebujete">
        {["Sedačka", "Křeslo", "Židle", "Starožitnost", "Oprava", "Jiné"].map((c, i) => (
          <label class="chip"><input type="radio" name="nabytek" value={c} checked={i === 0} /><span>{c}</span></label>
        ))}
      </div>
      <label class="fl"><input name="jmeno" required placeholder=" " autocomplete="name" /><span>Jméno</span></label>
      <label class="fl"><input name="telefon" type="tel" required placeholder=" " autocomplete="tel" /><span>Telefon</span></label>
      <label class="fl"><input name="email" type="email" placeholder=" " autocomplete="email" /><span>E-mail (nepovinné)</span></label>
      <label class="fl"><textarea name="popis" rows="3" placeholder=" "></textarea><span>Co s nábytkem chcete udělat?</span></label>
      <button class="btn full" type="submit">Odeslat poptávku →</button>
      <p class="note">Fotku můžete poslat i na {firma.email}</p>
    </form>
  </section>

  <footer class="foot">
    <span>© {new Date().getFullYear()} {firma.nazev}</span>
    <span>{firma.adresa}, {firma.mesto}</span>
  </footer>

  <a class="fab" href={`tel:${firma.telefonOdkaz}`}>Zavolat</a>

  <script>
    const c = document.querySelector(".compare");
    const r = c?.querySelector("input");
    r?.addEventListener("input", () => c.style.setProperty("--pos", r.value + "%"));
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }), { threshold: 0.12 });
    document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
  </script>
</body>
</html>

<style is:global>
  :root{--bg:#16110e;--bg2:#211a16;--cream:#efe6d8;--muted:#a89a8a;--acc:#d07a45;--line:rgba(239,230,216,.12);--serif:"Instrument Serif",Georgia,serif;--sans:"Manrope",system-ui,sans-serif}
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{background:var(--bg);color:var(--cream);font-family:var(--sans);font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}
  em{font-style:italic;color:var(--acc)}
  h1,h2{font-family:var(--serif);font-weight:400;letter-spacing:-.02em;line-height:.95}
  h2{font-size:clamp(2.6rem,6vw,4.8rem)}
  h3{font-weight:600;font-size:1.15rem;margin-bottom:6px}

  .reveal{opacity:0;transform:translateY(24px);transition:opacity .8s cubic-bezier(.2,.7,.2,1),transform .8s cubic-bezier(.2,.7,.2,1)}
  .reveal.in{opacity:1;transform:none}
  @media (prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}.track{animation:none!important}}

  .nav{position:fixed;inset:16px 16px auto;z-index:40;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:10px 10px 10px 22px;border-radius:999px;background:rgba(22,17,14,.7);backdrop-filter:blur(14px);border:1px solid var(--line)}
  .brand{font-weight:700;letter-spacing:-.01em}
  .brand span{color:var(--acc);margin:0 3px}
  .links{display:flex;gap:28px;font-size:.92rem;color:var(--muted)}
  .links a:hover{color:var(--cream)}
  .pill{background:var(--cream);color:var(--bg);font-weight:600;font-size:.9rem;padding:10px 18px;border-radius:999px;transition:.2s}
  .pill:hover{background:var(--acc);color:#fff}

  .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--acc);color:#fff;font-weight:600;padding:16px 26px;border-radius:999px;border:0;font:600 1rem var(--sans);cursor:pointer;transition:transform .2s,background .2s}
  .btn:hover{transform:translateY(-2px);background:#e08a55}
  .btn.ghost{background:transparent;border:1px solid var(--line);color:var(--cream)}
  .btn.ghost:hover{background:var(--bg2)}
  .btn.full{width:100%}

  .hero{position:relative;min-height:100vh;padding:140px 5vw 60px;display:flex;flex-direction:column;justify-content:flex-end;overflow:hidden}
  .hero h1{font-size:clamp(3.6rem,12vw,11rem);position:relative;z-index:2;margin:24px 0 40px}
  .tag{position:relative;z-index:2;background:rgba(22,17,14,.8);display:inline-flex;align-items:center;gap:10px;font-size:.85rem;color:var(--muted);border:1px solid var(--line);padding:8px 16px;border-radius:999px}
  .dot{width:8px;height:8px;border-radius:50%;background:#7bc47f;box-shadow:0 0 0 4px rgba(123,196,127,.2)}
  .hero-bottom{display:grid;grid-template-columns:1.3fr auto auto;gap:40px;align-items:end;position:relative;z-index:2;border-top:1px solid var(--line);padding-top:30px}
  .lead{color:var(--muted);max-width:480px;font-size:1.1rem}
  .hero-actions{display:flex;gap:10px;flex-wrap:wrap}
  .years{display:flex;align-items:center;gap:10px}
  .years strong{font-family:var(--serif);font-size:5rem;line-height:.8;color:var(--acc)}
  .years span{font-size:.8rem;text-transform:uppercase;letter-spacing:.12em;color:var(--muted)}
  .fabric{position:absolute;right:-10vw;top:8vh;width:55vw;height:70vh;border-radius:48% 52% 40% 60%/50% 40% 60% 50%;background:repeating-linear-gradient(45deg,rgba(208,122,69,.18) 0 2px,transparent 2px 9px),repeating-linear-gradient(-45deg,rgba(239,230,216,.06) 0 2px,transparent 2px 9px),radial-gradient(circle at 30% 30%,#5a3220,#2a1a12 70%);filter:blur(.3px);opacity:.75;animation:float 14s ease-in-out infinite}
  @keyframes float{50%{transform:translate(-2vw,2vh) rotate(4deg);border-radius:55% 45% 52% 48%/45% 55% 45% 55%}}

  .marquee{overflow:hidden;border-block:1px solid var(--line);background:var(--acc);color:#1b120c;padding:18px 0}
  .track{display:flex;width:max-content;animation:mq 30s linear infinite;font-family:var(--serif);font-size:1.8rem;white-space:nowrap}
  @keyframes mq{to{transform:translateX(-50%)}}

  .sec{padding:120px 5vw}
  .narrow{max-width:980px;margin:0 auto}
  .head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:54px;flex-wrap:wrap}
  .kicker{font-size:.8rem;text-transform:uppercase;letter-spacing:.16em;color:var(--muted)}
  .kicker.light{color:rgba(27,18,12,.6)}

  .compare{position:relative;aspect-ratio:16/8;border-radius:28px;overflow:hidden;border:1px solid var(--line);user-select:none}
  .layer{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .layer.top{clip-path:inset(0 0 0 var(--pos))}
  .layer.top img,.layer.top .ph-new{width:100%;height:100%;object-fit:cover}
  .ph-old{background:repeating-linear-gradient(135deg,#6e655c 0 14px,#625a52 14px 28px);filter:grayscale(.4)}
  .ph-new{background:repeating-linear-gradient(45deg,#a8492f 0 7px,#933e27 7px 14px)}
  .ph-old span,.ph-new span{position:absolute;bottom:20px;padding:6px 14px;border-radius:999px;background:rgba(22,17,14,.75);font-size:.8rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase}
  .ph-old span{left:20px}.ph-new span{right:20px}
  .handle{position:absolute;top:0;bottom:0;left:var(--pos);width:2px;background:var(--cream);transform:translateX(-1px);pointer-events:none}
  .handle span{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:54px;height:54px;border-radius:50%;background:var(--cream);color:var(--bg);display:grid;place-items:center;font-size:1.3rem;box-shadow:0 10px 30px rgba(0,0,0,.4)}
  .compare input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize}
  .cap{position:absolute;top:20px;left:20px;font-family:var(--serif);font-size:1.6rem;pointer-events:none}
  .thumbs{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:20px}
  .thumb{border-radius:22px;overflow:hidden;position:relative;aspect-ratio:16/10;border:1px solid var(--line)}
  .thumb img,.thumb div{width:100%;height:100%;object-fit:cover}
  .thumb .t0{background:repeating-linear-gradient(0deg,#3f5a4c 0 4px,#4a6857 4px 8px)}
  .thumb .t1{background:radial-gradient(circle at 4px 4px,#b89668 1.5px,transparent 2px) 0 0/11px 11px,#d8c09a}
  .thumb figcaption{position:absolute;left:18px;bottom:16px;font-family:var(--serif);font-size:1.4rem;background:rgba(22,17,14,.7);padding:4px 14px;border-radius:999px}

  .bento{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:minmax(200px,auto);gap:16px}
  .tile{background:var(--bg2);border:1px solid var(--line);border-radius:24px;padding:30px;display:flex;flex-direction:column;justify-content:flex-end;position:relative;overflow:hidden;transition:border-color .3s,transform .3s}
  .tile:hover{border-color:rgba(208,122,69,.6);transform:translateY(-4px)}
  .tile p{color:var(--muted);font-size:.96rem}
  .tile .n{position:absolute;top:24px;left:30px;font-family:var(--serif);font-size:1.4rem;color:var(--acc)}
  .tile.t0{grid-column:span 2;grid-row:span 2;background:linear-gradient(160deg,rgba(208,122,69,.25),transparent 60%),repeating-linear-gradient(45deg,rgba(239,230,216,.04) 0 2px,transparent 2px 10px),var(--bg2)}
  .tile.t0 h3{font-family:var(--serif);font-weight:400;font-size:3rem;line-height:1}
  .tile.t0 p{font-size:1.1rem;max-width:380px}
  .tile.t3{grid-column:span 2}
  .tile.t5{grid-column:span 3;background:var(--cream);color:var(--bg)}
  .tile.t5 p{color:#5d5046}

  .timeline{list-style:none;display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid var(--line)}
  .timeline li{padding:40px 30px 10px 0;position:relative}
  .timeline li::before{content:"";position:absolute;top:-6px;left:0;width:11px;height:11px;border-radius:50%;background:var(--acc)}
  .step{font-family:var(--serif);font-size:4.5rem;line-height:1;color:var(--bg2);-webkit-text-stroke:1px var(--muted);display:block;margin-bottom:14px}
  .timeline p{color:var(--muted);max-width:320px}

  .faq details{border-bottom:1px solid var(--line);padding:26px 0}
  .faq summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:20px;font-family:var(--serif);font-size:clamp(1.4rem,2.6vw,2rem)}
  .faq summary::-webkit-details-marker{display:none}
  .plus{width:34px;height:34px;flex-shrink:0;border-radius:50%;border:1px solid var(--line);position:relative;transition:.3s}
  .plus::before,.plus::after{content:"";position:absolute;top:50%;left:50%;width:12px;height:1.5px;background:var(--cream);transform:translate(-50%,-50%)}
  .plus::after{transform:translate(-50%,-50%) rotate(90deg);transition:.3s}
  details[open] .plus{background:var(--acc);border-color:var(--acc)}
  details[open] .plus::after{transform:translate(-50%,-50%) rotate(0)}
  .faq p{color:var(--muted);margin-top:14px;max-width:680px}

  .contact{margin:0 2vw 2vw;border-radius:36px;background:var(--cream);color:#1b120c;padding:90px 4vw;display:grid;grid-template-columns:1.1fr 1fr;gap:60px}
  .contact em{color:#b5582a}
  .bigphone{display:inline-block;font-family:var(--serif);font-size:clamp(2.6rem,6vw,4.6rem);margin:30px 0 20px;border-bottom:2px solid #b5582a;line-height:1.1}
  .cinfo{list-style:none;margin-bottom:24px}
  .cinfo li{display:flex;gap:16px;padding:12px 0;border-bottom:1px solid rgba(27,18,12,.12)}
  .cinfo span{width:90px;flex-shrink:0;color:#7a6b5e;font-size:.9rem}
  .map{width:100%;height:220px;border:0;border-radius:20px;filter:grayscale(.4) sepia(.2)}
  .form{background:#fff;border-radius:28px;padding:34px;display:grid;gap:14px;align-content:start;box-shadow:0 30px 60px -30px rgba(27,18,12,.35)}
  .chips{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:8px}
  .chip input{position:absolute;opacity:0}
  .chip span{display:inline-block;padding:9px 16px;border-radius:999px;border:1px solid #e2d7c6;font-size:.9rem;cursor:pointer;transition:.2s}
  .chip input:checked+span{background:#1b120c;color:var(--cream);border-color:#1b120c}
  .chip input:focus-visible+span{outline:2px solid #b5582a}
  .fl{position:relative;display:block}
  .fl input,.fl textarea{width:100%;font:inherit;padding:24px 16px 10px;border:1px solid #e2d7c6;border-radius:14px;background:#fbf8f3;color:#1b120c;resize:vertical}
  .fl span{position:absolute;left:17px;top:17px;color:#8c7d70;font-size:1rem;transition:.2s;pointer-events:none}
  .fl input:focus+span,.fl input:not(:placeholder-shown)+span,.fl textarea:focus+span,.fl textarea:not(:placeholder-shown)+span{top:7px;font-size:.72rem;letter-spacing:.04em}
  .fl input:focus,.fl textarea:focus{outline:2px solid #b5582a;border-color:transparent}
  .note{font-size:.85rem;color:#8c7d70;text-align:center}

  .foot{display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;padding:30px 5vw 40px;color:var(--muted);font-size:.9rem}
  .fab{display:none}

  @media (max-width:900px){
    .links{display:none}
    .hero{min-height:auto;padding-top:120px}
    .hero-bottom{grid-template-columns:1fr;gap:24px}
    .years strong{font-size:3.6rem}
    .fabric{width:90vw;height:45vh;top:12vh;right:-30vw}
    .sec{padding:80px 5vw}
    .compare{aspect-ratio:4/5}
    .thumbs{grid-template-columns:1fr}
    .bento{grid-template-columns:1fr}
    .tile.t0,.tile.t3,.tile.t5{grid-column:auto;grid-row:auto}
    .tile{min-height:190px}
    .tile.t0 h3{font-size:2.4rem}
    .timeline{grid-template-columns:1fr}
    .contact{grid-template-columns:1fr;padding:60px 6vw;gap:40px}
    .fab{display:block;position:fixed;left:16px;right:16px;bottom:16px;z-index:50;text-align:center;background:var(--acc);color:#fff;font-weight:700;padding:16px;border-radius:999px;box-shadow:0 10px 30px rgba(0,0,0,.4)}
    .foot{padding-bottom:100px}
  }
</style>
