---
// ================= ÚPRAVY TADY =================
// Přepisuj jen texty v uvozovkách. Uvozovky a čárky nech.
const firma = {
  nazev: "Čalounictví Roman Ehl",
  jmeno: "Roman Ehl",
  telefon: "603 477 360",
  telefonOdkaz: "+420603477360",
  email: "roman.ehl@seznam.cz",
  adresa: "Hořická 364/15",
  mesto: "500 02 Hradec Králové",
  odRoku: 1991,
  provozni: "Po telefonické domluvě",
};

const sluzby = [
  { nazev: "Sedačky a gauče", text: "Přečalounění celé sedačky nebo jen opotřebených dílů. Nová látka, nová výplň, stará kostra zůstává.", ikona: "sofa" },
  { nazev: "Křesla", text: "Ušák po babičce, klubové křeslo i moderní kousek. Vrátíme mu tvar, pohodlí i vzhled.", ikona: "chair" },
  { nazev: "Jídelní židle a lavice", text: "Sedáky a opěradla židlí, lavice do kuchyně, barové stoličky.", ikona: "stool" },
  { nazev: "Starožitný nábytek", text: "Šetrné přečalounění historického nábytku tradičními postupy, s respektem k původnímu řemeslu.", ikona: "antique" },
  { nazev: "Opravy výplní a pružin", text: "Propadlý sedák, vrzající pružiny, roztržený potah. Opravíme jen to, co je potřeba.", ikona: "spring" },
  { nazev: "Čalounické potřeby", text: "Prodej čalounických materiálů a potřeb. Poradíme, co na Vaši práci použít.", ikona: "fabric" },
];

const postup = [
  { nazev: "Pošlete fotku", text: "Zavolejte nebo vyplňte poptávku. Stačí fotka nábytku a pár slov, co s ním chcete udělat." },
  { nazev: "Vyberete látku", text: "Domluvíme cenu a termín. Pomůžu vybrat látku, která vydrží a bude se k Vám hodit." },
  { nazev: "Hotovo", text: "Nábytek přečalouním v dílně v Hradci. Domluvíme se, jak se k Vám vrátí jako nový." },
];

// Fotky: nahraj do public/img/ a dopiš sem názvy, např. { pred: "/img/kreslo-pred.jpg", po: "/img/kreslo-po.jpg", popis: "Ušák" }
const galerie = [
  { pred: "", po: "", popis: "Ušák po babičce" },
  { pred: "", po: "", popis: "Rohová sedačka" },
  { pred: "", po: "", popis: "Jídelní židle" },
];
// ================= KONEC ÚPRAV =================

const roky = new Date().getFullYear() - firma.odRoku;
const mapa = `https://www.google.com/maps?q=${encodeURIComponent(firma.adresa + ", " + firma.mesto)}&output=embed`;
const mapaOdkaz = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(firma.adresa + ", " + firma.mesto)}`;
---
<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{firma.nazev} | Přečalounění sedaček a křesel Hradec Králové</title>
  <meta name="description" content={`Čalounictví v Hradci Králové od roku ${firma.odRoku}. Přečalounění sedaček, křesel, židlí a starožitného nábytku, opravy pružin a výplní, prodej čalounických potřeb. Tel. ${firma.telefon}.`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "LocalBusiness", name: firma.nazev,
    telephone: firma.telefonOdkaz, email: firma.email,
    address: { "@type": "PostalAddress", streetAddress: firma.adresa, addressLocality: "Hradec Králové", postalCode: "500 02", addressCountry: "CZ" },
  })} />
</head>
<body>
  <header class="nav">
    <div class="wrap nav-in">
      <a href="#" class="logo"><span class="logo-mark">E</span><span>Čalounictví <b>Ehl</b></span></a>
      <nav class="links">
        <a href="#sluzby">Služby</a><a href="#postup">Jak to probíhá</a><a href="#prace">Práce</a><a href="#kontakt">Kontakt</a>
      </nav>
      <a class="btn btn-sm" href={`tel:${firma.telefonOdkaz}`}>Zavolat</a>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap hero-in">
        <div>
          <p class="eyebrow">Čalounictví v Hradci Králové · od roku {firma.odRoku}</p>
          <h1>Starý nábytek,<br /><em>nový život.</em></h1>
          <p class="lead">Přečalouním Vaši sedačku, křeslo nebo židle tak, aby Vám sloužily další roky. Poctivé řemeslo, dílna v Hradci a osobní přístup.</p>
          <div class="cta">
            <a class="btn" href={`tel:${firma.telefonOdkaz}`}>Zavolat {firma.telefon}</a>
            <a class="btn btn-ghost" href="#kontakt">Poslat poptávku</a>
          </div>
        </div>
        <div class="hero-card" aria-hidden="true">
          <div class="swatches">
            <span class="sw sw1"></span><span class="sw sw2"></span><span class="sw sw3"></span><span class="sw sw4"></span>
          </div>
          <div class="stat"><strong>{roky}+</strong><span>let v oboru</span></div>
          <div class="stitch">ruční práce · výběr látek · opravy i celé přečalounění</div>
        </div>
      </div>
    </section>

    <section id="sluzby" class="section">
      <div class="wrap">
        <p class="eyebrow">Služby</p>
        <h2>Co pro Vás udělám</h2>
        <div class="grid3">
          {sluzby.map((s) => (
            <article class="card">
              <div class={`ico ico-${s.ikona}`}></div>
              <h3>{s.nazev}</h3>
              <p>{s.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap band-in">
        <p class="quote">Kvalitní kostru je škoda vyhodit. Nová látka a výplň často stojí jen zlomek ceny nového nábytku.</p>
      </div>
    </section>

    <section id="postup" class="section">
      <div class="wrap">
        <p class="eyebrow">Jak to probíhá</p>
        <h2>Tři kroky k novému potahu</h2>
        <ol class="steps">
          {postup.map((k, i) => (
            <li><span class="num">{i + 1}</span><h3>{k.nazev}</h3><p>{k.text}</p></li>
          ))}
        </ol>
      </div>
    </section>

    <section id="prace" class="section alt">
      <div class="wrap">
        <p class="eyebrow">Ukázky práce</p>
        <h2>Před a po</h2>
        <div class="grid3">
          {galerie.map((g, i) => (
            <figure class="ba">
              <div class="ba-row">
                {g.pred ? <img src={g.pred} alt={`${g.popis} před`} loading="lazy" /> : <div class={`ph ph-old ph${i}`}><span>před</span></div>}
                {g.po ? <img src={g.po} alt={`${g.popis} po`} loading="lazy" /> : <div class={`ph ph-new ph${i}`}><span>po</span></div>}
              </div>
              <figcaption>{g.popis}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section id="kontakt" class="section">
      <div class="wrap contact">
        <div>
          <p class="eyebrow">Kontakt</p>
          <h2>Napište nebo zavolejte</h2>
          <p class="muted">Nejrychlejší je poslat fotku nábytku. Ozvu se s odhadem ceny a termínu.</p>
          <ul class="info">
            <li><span>Telefon</span><a href={`tel:${firma.telefonOdkaz}`}>{firma.telefon}</a></li>
            <li><span>E-mail</span><a href={`mailto:${firma.email}`}>{firma.email}</a></li>
            <li><span>Dílna</span><a href={mapaOdkaz} target="_blank" rel="noopener">{firma.adresa}, {firma.mesto}</a></li>
            <li><span>Otevřeno</span>{firma.provozni}</li>
          </ul>
          <iframe class="map" src={mapa} loading="lazy" title="Mapa dílny" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <form class="form" action={`https://formsubmit.co/${firma.email}`} method="POST">
          <input type="hidden" name="_subject" value="Nová poptávka z webu – čalounictví" />
          <input type="hidden" name="_template" value="table" />
          <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" />
          <h3>Nezávazná poptávka</h3>
          <label>Jméno<input name="jmeno" required autocomplete="name" /></label>
          <div class="row2">
            <label>Telefon<input name="telefon" type="tel" required autocomplete="tel" /></label>
            <label>E-mail<input name="email" type="email" autocomplete="email" /></label>
          </div>
          <label>Co potřebujete přečalounit?
            <select name="nabytek">
              <option>Sedačka / gauč</option><option>Křeslo</option><option>Židle / lavice</option><option>Starožitný nábytek</option><option>Oprava (pružiny, výplň)</option><option>Jiné</option>
            </select>
          </label>
          <label>Popis<textarea name="popis" rows="4" placeholder="Např. rohová sedačka, chci novou látku a zpevnit sedáky."></textarea></label>
          <button class="btn" type="submit">Odeslat poptávku</button>
          <p class="small">Fotku nábytku můžete poslat na <a href={`mailto:${firma.email}`}>{firma.email}</a>.</p>
        </form>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-in">
      <span>© {new Date().getFullYear()} {firma.nazev}</span>
      <span>{firma.adresa}, {firma.mesto} · <a href={`tel:${firma.telefonOdkaz}`}>{firma.telefon}</a></span>
    </div>
  </footer>

  <a class="fab" href={`tel:${firma.telefonOdkaz}`} aria-label="Zavolat">☎</a>
</body>
</html>

<style is:global>
  :root{--bg:#f5efe5;--paper:#fbf8f2;--ink:#2b221d;--muted:#6b5f56;--acc:#8a3a2b;--acc2:#3f5a4c;--line:#e3d8c7;--serif:"Fraunces",Georgia,serif;--sans:"Inter",system-ui,sans-serif}
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{font-family:var(--sans);background:var(--bg);color:var(--ink);line-height:1.6;font-size:17px}
  a{color:inherit}
  .wrap{max-width:1120px;margin:0 auto;padding:0 22px}
  h1,h2,h3{font-family:var(--serif);font-weight:600;line-height:1.1;letter-spacing:-.01em}
  h1{font-size:clamp(2.6rem,6vw,4.4rem)}
  h1 em{color:var(--acc);font-style:italic;font-weight:500}
  h2{font-size:clamp(2rem,4vw,2.8rem);margin-bottom:34px}
  h3{font-size:1.3rem;margin-bottom:8px}
  .eyebrow{text-transform:uppercase;letter-spacing:.14em;font-size:.78rem;font-weight:600;color:var(--acc);margin-bottom:12px}
  .muted{color:var(--muted)}
  .btn{display:inline-block;background:var(--acc);color:#fff;text-decoration:none;font-weight:600;padding:14px 24px;border-radius:999px;border:2px solid var(--acc);transition:.2s;cursor:pointer;font-size:1rem;font-family:var(--sans)}
  .btn:hover{background:#6f2d21;border-color:#6f2d21}
  .btn-ghost{background:transparent;color:var(--ink);border-color:var(--ink)}
  .btn-ghost:hover{background:var(--ink);color:#fff;border-color:var(--ink)}
  .btn-sm{padding:9px 18px;font-size:.9rem}

  .nav{position:sticky;top:0;z-index:20;background:rgba(245,239,229,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
  .nav-in{display:flex;align-items:center;justify-content:space-between;height:68px;gap:20px}
  .logo{display:flex;align-items:center;gap:10px;text-decoration:none;font-family:var(--serif);font-size:1.2rem}
  .logo-mark{width:36px;height:36px;border-radius:50%;background:var(--acc);color:#fff;display:grid;place-items:center;font-weight:600}
  .links{display:flex;gap:26px}
  .links a{text-decoration:none;font-size:.95rem;color:var(--muted)}
  .links a:hover{color:var(--ink)}

  .hero{padding:84px 0 90px}
  .hero-in{display:grid;grid-template-columns:1.2fr .8fr;gap:56px;align-items:center}
  .lead{font-size:1.2rem;color:var(--muted);max-width:540px;margin:22px 0 32px}
  .cta{display:flex;gap:12px;flex-wrap:wrap}
  .hero-card{background:var(--paper);border:1px solid var(--line);border-radius:22px;padding:28px;box-shadow:0 30px 60px -30px rgba(43,34,29,.35);position:relative}
  .swatches{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .sw{aspect-ratio:1;border-radius:14px;display:block}
  .sw1{background:repeating-linear-gradient(45deg,#8a3a2b 0 6px,#7a3226 6px 12px)}
  .sw2{background:repeating-linear-gradient(0deg,#3f5a4c 0 3px,#4a6857 3px 6px),#3f5a4c}
  .sw3{background:radial-gradient(circle at 3px 3px,#c9a978 1.2px,transparent 1.5px) 0 0/9px 9px,#d8c09a}
  .sw4{background:repeating-linear-gradient(90deg,#2b221d 0 2px,#3a2f28 2px 8px)}
  .stat{position:absolute;right:-18px;top:-18px;background:var(--ink);color:#fff;border-radius:16px;padding:14px 18px;text-align:center}
  .stat strong{display:block;font-family:var(--serif);font-size:2rem;line-height:1}
  .stat span{font-size:.75rem;opacity:.8}
  .stitch{margin-top:18px;padding-top:14px;border-top:2px dashed var(--line);font-size:.85rem;color:var(--muted);text-align:center}

  .section{padding:90px 0}
  .alt{background:var(--paper);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  .card{background:var(--paper);border:1px solid var(--line);border-radius:18px;padding:28px;transition:.2s}
  .card:hover{transform:translateY(-3px);box-shadow:0 18px 40px -24px rgba(43,34,29,.4)}
  .card p{color:var(--muted);font-size:.97rem}
  .ico{width:46px;height:46px;border-radius:12px;margin-bottom:18px;background:var(--bg);border:1px solid var(--line);position:relative}
  .ico::after{content:"";position:absolute;inset:11px;border-radius:5px;background:var(--acc)}
  .ico-chair::after,.ico-antique::after{background:var(--acc2);border-radius:50% 50% 5px 5px}
  .ico-stool::after{inset:13px 9px;border-radius:999px}
  .ico-spring::after{background:repeating-linear-gradient(0deg,var(--acc) 0 3px,transparent 3px 6px)}
  .ico-fabric::after{background:repeating-linear-gradient(45deg,var(--acc2) 0 4px,#d8c09a 4px 8px)}

  .band{background:var(--ink);color:#f5efe5;padding:70px 0}
  .band-in{text-align:center;max-width:820px}
  .quote{font-family:var(--serif);font-size:clamp(1.4rem,3vw,2rem);font-style:italic;line-height:1.35}
  .sig{margin-top:18px;opacity:.7;font-size:.9rem}

  .steps{list-style:none;display:grid;grid-template-columns:repeat(3,1fr);gap:20px;counter-reset:s}
  .steps li{border-top:2px dashed var(--line);padding-top:24px}
  .num{display:inline-grid;place-items:center;width:42px;height:42px;border-radius:50%;background:var(--acc2);color:#fff;font-weight:600;margin-bottom:14px}
  .steps p{color:var(--muted)}

  .ba{background:var(--bg);border:1px solid var(--line);border-radius:18px;padding:12px}
  .ba-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .ba img,.ph{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:12px;display:block}
  .ph{display:grid;place-items:end start;padding:10px}
  .ph span{background:rgba(255,255,255,.9);font-size:.75rem;font-weight:600;padding:3px 9px;border-radius:999px;text-transform:uppercase;letter-spacing:.08em}
  .ph-old{background:repeating-linear-gradient(135deg,#bfb3a3 0 10px,#b3a696 10px 20px);filter:saturate(.6)}
  .ph-new.ph0{background:repeating-linear-gradient(45deg,#8a3a2b 0 6px,#7a3226 6px 12px)}
  .ph-new.ph1{background:repeating-linear-gradient(0deg,#3f5a4c 0 3px,#4a6857 3px 6px)}
  .ph-new.ph2{background:radial-gradient(circle at 3px 3px,#c9a978 1.2px,transparent 1.5px) 0 0/9px 9px,#d8c09a}
  .ba figcaption{padding:12px 6px 4px;font-family:var(--serif);font-size:1.1rem}

  .contact{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start}
  .info{list-style:none;margin:26px 0}
  .info li{display:flex;gap:16px;padding:14px 0;border-bottom:1px solid var(--line)}
  .info span{width:90px;flex-shrink:0;color:var(--muted);font-size:.9rem}
  .info a{text-decoration:none;font-weight:500}
  .info a:hover{color:var(--acc)}
  .map{width:100%;height:240px;border:0;border-radius:16px;filter:sepia(.25)}
  .form{background:var(--paper);border:1px solid var(--line);border-radius:22px;padding:32px;display:grid;gap:16px}
  .form h3{font-size:1.6rem}
  .form label{display:grid;gap:6px;font-size:.9rem;font-weight:500}
  .form input,.form select,.form textarea{font:inherit;font-size:1rem;padding:12px 14px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--ink)}
  .form input:focus,.form select:focus,.form textarea:focus{outline:2px solid var(--acc);border-color:transparent}
  .row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .small{font-size:.85rem;color:var(--muted)}

  .foot{border-top:1px solid var(--line);padding:28px 0;font-size:.9rem;color:var(--muted)}
  .foot-in{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
  .fab{display:none}

  @media (max-width:860px){
    .links{display:none}
    .hero{padding:48px 0 60px}
    .hero-in,.contact{grid-template-columns:1fr;gap:40px}
    .hero-card{max-width:360px}
    .grid3,.steps{grid-template-columns:1fr}
    .section{padding:64px 0}
    .row2{grid-template-columns:1fr}
    .fab{display:grid;place-items:center;position:fixed;right:18px;bottom:18px;width:58px;height:58px;border-radius:50%;background:var(--acc);color:#fff;text-decoration:none;font-size:1.5rem;box-shadow:0 10px 30px rgba(0,0,0,.25);z-index:30}
  }
</style>
